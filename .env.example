# ─────────────────────────────────────────────────────────────
# ESPN Fantasy Football AI Manager — environment template
# Copy to .env and fill in. Do not commit .env.
# ─────────────────────────────────────────────────────────────

# ── ESPN credentials (required) ──
# From your browser's dev tools after logging into ESPN Fantasy.
# Keep the curly braces on ESPN_SWID.
ESPN_S2=your_espn_s2_cookie_here
ESPN_SWID={your_swid_here}

# ── Leagues (LEAGUE_1_* required, LEAGUE_2_* optional) ──
LEAGUE_1_ID=your_first_league_id
LEAGUE_1_TEAM_ID=your_team_id_in_league_1
LEAGUE_1_NAME=League 1 Name

# Leave the LEAGUE_2_* lines commented out if you only manage one league.
#LEAGUE_2_ID=your_second_league_id
#LEAGUE_2_TEAM_ID=your_team_id_in_league_2
#LEAGUE_2_NAME=League 2 Name

# ── LLM providers (at least one API key required) ──
GEMINI_API_KEY=your_gemini_key_here
#CLAUDE_API_KEY=sk-ant-your_claude_key_here
#OPENAI_API_KEY=sk-proj-your_openai_key_here
#PERPLEXITY_API_KEY=pplx-your_perplexity_key_here

# Provider selection: claude | openai | gemini | perplexity
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=claude

# Gemini model override. Set this rather than editing code when Google
# retires a model. Defaults to gemini-3.7-flash if unset.
GEMINI_MODEL=gemini-3.7-flash

# ── FantasyPros (optional, improves rankings) ──
# Session cookie is preferred over email/password.
#FANTASYPROS_SESSION_ID=your_session_cookie_value
#FANTASYPROS_EMAIL=your_fantasypros_email
#FANTASYPROS_PASSWORD=your_fantasypros_password

# ── Optional data sources ──
#NEWS_API_KEY=your_newsapi_key_here
#OPENWEATHER_API_KEY=your_openweather_key_here

# Feature toggles (default on where the corresponding key is present)
ENABLE_FANTASYPROS=true
ENABLE_NEWS=false
ENABLE_WEATHER=false

# ── Notifications (optional) ──
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ── Cost limits, USD ──
# NOTE: two independent limit systems read DIFFERENT variable names.
#   COST_*  -> shared/src/services/costMonitor.ts (enforces limits, sends alerts)
#   *_COST_ -> automation/src/config/production.ts (Phase 4 budget config)
# Set both, or one of them silently runs on built-in defaults.
COST_DAILY_LIMIT=2.00
COST_WEEKLY_LIMIT=10.00
COST_MONTHLY_LIMIT=35.00
COST_PER_ANALYSIS_LIMIT=1.00

DAILY_COST_LIMIT=2.00
WEEKLY_COST_LIMIT=10.00
MONTHLY_COST_LIMIT=35.00
PER_ANALYSIS_LIMIT=1.00

# ── Local API server only ──
PORT=3003
#DEBUG_ESPN=false

# ── Advanced tuning (optional; sensible defaults in code) ──
#ENABLE_DRY_RUN=false
#ENABLE_AB_TESTING=true
#ENABLE_PERFORMANCE_TRACKING=true
#ENABLE_CROSS_LEAGUE=true
#MAX_CONCURRENT_LEAGUES=2
#MAX_EXECUTION_TIME=300000
#RETRY_ATTEMPTS=3
#TIMEZONE=America/New_York
