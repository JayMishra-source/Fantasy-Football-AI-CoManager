{
  "mcpServers": {
    "espn-fantasy-manager": {
      "command": "node",
      "args": ["/path/to/your/project/fantasy-engine/mcp-server/dist/index.js"],
      "env": {
        "ESPN_S2": "your_espn_s2_cookie_here",
        "ESPN_SWID": "{your_swid_here}",
        "LEAGUE_1_ID": "your_league_1_id",
        "LEAGUE_1_TEAM_ID": "your_team_id",
        "LEAGUE_1_NAME": "Your League Name",
        "LEAGUE_2_ID": "your_league_2_id",
        "LEAGUE_2_TEAM_ID": "your_team_id",
        "LEAGUE_2_NAME": "Your Other League Name",
        "GEMINI_API_KEY": "your_gemini_api_key_here",
        "GEMINI_MODEL": "gemini-3.7-flash",
        "PRIMARY_LLM_PROVIDER": "gemini",
        "FANTASYPROS_SESSION_ID": "your_fantasypros_session_id_here",
        "COST_DAILY_LIMIT": "2.00",
        "COST_WEEKLY_LIMIT": "10.00",
        "COST_MONTHLY_LIMIT": "35.00",
        "COST_PER_ANALYSIS_LIMIT": "1.00"
      }
    }
  }
}
